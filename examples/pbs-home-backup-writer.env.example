# Install as /etc/pbs-home-backup-writer.env with root:root mode 0600.
# This must use a backup-writer token, never the restore broker's read-only token.
PBS_PASSWORD='REPLACE_WITH_BACKUP_TOKEN_SECRET'
PBS_FINGERPRINT='REPLACE_WITH_VERIFIED_PBS_FINGERPRINT'
PBS_REPOSITORY='backup@pbs!home-writer@pbs.example.edu:DATASTORE'
PBS_HOME_BACKUP_ARCHIVE='root.pxar'
PBS_HOME_BACKUP_SOURCE='/home'
PBS_HOME_BACKUP_ID='storage-server'
PBS_HOME_BACKUP_DAILY_MODE='metadata'
# ISO weekday: 1=Monday through 7=Sunday.
PBS_HOME_BACKUP_FULL_SCAN_WEEKDAY='7'
